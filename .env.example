# Example environment variables for nefit-homekit development.
# Copy to .env and adjust before running `nix develop`.

NEFITHK_BRIDGE_NAME=tasmota-homekit-dev
NEFITHK_NEFIT_SERIAL=your-serial
NEFITHK_NEFIT_ACCESS_KEY=your-access-key
NEFITHK_NEFIT_PASSWORD=your-password
NEFITHK_HAP_PIN=00102003
NEFITHK_HAP_ADDR=0.0.0.0:12345
NEFITHK_WEB_ADDR=0.0.0.0:8080
NEFITHK_LOG_LEVEL=info
NEFITHK_LOG_FORMAT=json

# Optional: override when the Tailscale hostname should differ from the bridge.
NEFITHK_TAILSCALE_HOSTNAME=tasmota-homekit-dev
# NEFITHK_TAILSCALE_AUTHKEY=tskey-abc
# NEFITHK_TAILSCALE_STATE_DIR=/var/lib/nefit-homekit-dev/tailscale
